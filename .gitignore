# WorkBuddy 工作区记忆（含项目档案/用户信息，不入库）
.workbuddy/

# 构建/备份副本
dist/

# 依赖与本地环境
node_modules/
.env
*.log

# 系统文件
.DS_Store
Thumbs.db

# wrangler 本地缓存（含账号信息）
.wrangler/

# 部署缓存
.deploy_timestamp
.deploy_version

# 残留的 Windows 保留设备名文件（不可通过 Win32 删除，忽略之，不影响看板）
nul

# 临时备份/一次性生成物（不入库，避免误提交）
_backup/
inventory_backup_*.xlsx
inventory_2026_forecast.html

# 临时分析脚本（不入库）
_*.mjs

# 大文件：transship.xlsx 超过 Cloudflare Pages 单文件 25MB 上限，不入库（网页只加载 transship.json）
transship.xlsx
